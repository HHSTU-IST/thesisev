{
  "metadata": {
    "preset": "report_iot",
    "name": "物联网报告格式规范",
    "target_model": "python-docx",
    "version": "1.0"
  },
  "sections": [
    {
      "id": "document_layout",
      "name": "文档版式",
      "weight": 1,
      "rules": [
        {
          "id": "title_font",
          "label": "一级标题字体",
          "points": 2,
          "expected": {
            "paragraph.style": "Heading 1",
            "run.font.name": "黑体",
            "run.font.size": "16pt",
            "run.font.bold": true
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对一级标题是否使用 Heading 1 样式，且字体为黑体、16pt、加粗。"
        },
        {
          "id": "subtitle_font",
          "label": "二级标题字体",
          "points": 2,
          "expected": {
            "paragraph.style": "Heading 2",
            "run.font.name": "黑体",
            "run.font.size": "14pt",
            "run.font.bold": true
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对二级标题是否使用 Heading 2 样式，且字体为黑体、14pt、加粗。"
        },
        {
          "id": "body_font",
          "label": "正文格式",
          "points": 3,
          "expected": {
            "paragraph.style": "Normal",
            "run.font.name": "宋体",
            "run.font.size": "12pt",
            "paragraph.alignment": "WD_ALIGN_PARAGRAPH.JUSTIFY",
            "paragraph_format.line_spacing": 1.5,
            "paragraph_format.space_before": "0pt",
            "paragraph_format.space_after": "0pt",
            "paragraph_format.first_line_indent": "2em"
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对正文是否采用宋体 12pt、1.5 倍行距、两端对齐、首行缩进 2 字符。"
        }
      ]
    },
    {
      "id": "tables_and_spacing",
      "name": "表格与段落",
      "weight": 1,
      "rules": [
        {
          "id": "paragraph_spacing",
          "label": "段前段后",
          "points": 2,
          "expected": {
            "paragraph_format.space_before": "0pt",
            "paragraph_format.space_after": "0pt"
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对正文段前和段后是否均为 0pt。"
        },
        {
          "id": "table_alignment",
          "label": "表格居中",
          "points": 2,
          "expected": {
            "table.alignment": "WD_TABLE_ALIGNMENT.CENTER"
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对表格整体是否居中对齐。"
        },
        {
          "id": "page_margins",
          "label": "页边距",
          "points": 2,
          "expected": {
            "section.top_margin": "2.5cm",
            "section.bottom_margin": "2.5cm",
            "section.left_margin": "3cm",
            "section.right_margin": "2.5cm"
          },
          "check": {
            "type": "manual_review"
          },
          "hint": "核对页面四周边距是否符合模板要求。"
        }
      ]
    },
    {
      "id": "content_length",
      "name": "篇幅与结构",
      "weight": 1,
      "rules": [
        {
          "id": "word_count",
          "label": "篇幅",
          "points": 2,
          "expected": {
            "document.word_count": "3500~4000"
          },
          "check": {
            "type": "word_count_range",
            "min": 3500,
            "max": 4000
          },
          "hint": "核对全文篇幅是否落在 3500 到 4000 字之间。"
        },
        {
          "id": "section_count",
          "label": "章节完整性",
          "points": 2,
          "expected": {
            "document.section_count": ">=4"
          },
          "check": {
            "type": "section_count_min",
            "min": 4
          },
          "hint": "核对报告是否包含足够的章节结构。"
        }
      ]
    }
  ]
}
