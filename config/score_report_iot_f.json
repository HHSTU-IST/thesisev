[
  {
    "id": "document_layout",
    "name": "文档版式",
    "weight": 1,
    "rules": [
      {
        "id": "chapter_font",
        "label": "二级标题字体",
        "points": 2,
        "check": {
          "type": "docx_expected",
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Heading 2"
            },
            {
              "path": "run.font.name",
              "value": "SimHei"
            },
            {
              "path": "run.font.size",
              "value": "16pt"
            }
          ]
        }
      },
      {
        "id": "subchapter_font",
        "label": "三级标题字体",
        "points": 2,
        "check": {
          "type": "docx_expected",
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Heading 3"
            },
            {
              "path": "run.font.name",
              "value": "SimHei"
            },
            {
              "path": "run.font.size",
              "value": "14pt"
            }
          ]
        }
      },
      {
        "id": "body_font",
        "label": "正文格式",
        "points": 5,
        "check": {
          "type": "docx_expected",
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Normal"
            },
            {
              "path": "run.font.name",
              "value": "SimSun"
            },
            {
              "path": "run.font.size",
              "value": "12pt"
            },
            {
              "path": "paragraph_format.line_spacing",
              "value": 1.5
            },
            {
              "path": "paragraph_format.space_before",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.space_after",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.first_line_indent",
              "value": "2ch"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "tables_and_spacing",
    "name": "表格与段落",
    "weight": 1,
    "rules": [
      {
        "id": "paragraph_spacing",
        "label": "段前段后",
        "points": 2,
        "check": {
          "type": "docx_expected",
          "expected": [
            {
              "path": "paragraph_format.space_before",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.space_after",
              "value": "0pt"
            }
          ]
        }
      },
      {
        "id": "table_alignment",
        "label": "表格居中",
        "points": 3,
        "check": {
          "type": "docx_expected",
          "expected": [
            {
              "path": "table.alignment",
              "value": "WD_TABLE_ALIGNMENT.CENTER"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "content_length",
    "name": "篇幅与结构",
    "weight": 1,
    "rules": [
      {
        "id": "word_count",
        "label": "篇幅",
        "points": 3,
        "check": {
          "type": "word_count_range",
          "expected": [
            {
              "path": "document.word_count",
              "value": "3500~4000"
            }
          ],
          "min": 3500,
          "max": 4000
        }
      },
      {
        "id": "section_count",
        "label": "章节完整性",
        "points": 3,
        "check": {
          "type": "section_count_min",
          "expected": [
            {
              "path": "document.section_count",
              "value": ">=4"
            }
          ],
          "min": 4
        }
      }
    ]
  }
]
