{
  "metadata": {
    "preset": "report_iot",
    "name": "物联网报告格式规范",
    "target_model": "python-docx",
    "expected_schema": "expected_items",
    "version": "1.0"
  },
  "sections": [
    {
      "id": "document_layout",
      "name": "文档版式",
      "weight": 1,
      "rules": [
        {
          "id": "title_font",
          "label": "一级标题字体",
          "points": 2,
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Heading 1"
            },
            {
              "path": "run.font.name",
              "value": "黑体"
            },
            {
              "path": "run.font.size",
              "value": "16pt"
            },
            {
              "path": "run.font.bold",
              "value": true
            }
          ],
          "check": {
            "type": "docx_expected"
          }
        },
        {
          "id": "subtitle_font",
          "label": "二级标题字体",
          "points": 2,
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Heading 2"
            },
            {
              "path": "run.font.name",
              "value": "黑体"
            },
            {
              "path": "run.font.size",
              "value": "14pt"
            },
            {
              "path": "run.font.bold",
              "value": true
            }
          ],
          "check": {
            "type": "docx_expected"
          }
        },
        {
          "id": "body_font",
          "label": "正文格式",
          "points": 3,
          "expected": [
            {
              "path": "paragraph.style",
              "value": "Normal"
            },
            {
              "path": "run.font.name",
              "value": "宋体"
            },
            {
              "path": "run.font.size",
              "value": "12pt"
            },
            {
              "path": "paragraph.alignment",
              "value": "WD_ALIGN_PARAGRAPH.JUSTIFY"
            },
            {
              "path": "paragraph_format.line_spacing",
              "value": 1.5
            },
            {
              "path": "paragraph_format.space_before",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.space_after",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.first_line_indent",
              "value": "24pt"
            }
          ],
          "check": {
            "type": "docx_expected"
          }
        }
      ]
    },
    {
      "id": "tables_and_spacing",
      "name": "表格与段落",
      "weight": 1,
      "rules": [
        {
          "id": "paragraph_spacing",
          "label": "段前段后",
          "points": 2,
          "expected": [
            {
              "path": "paragraph_format.space_before",
              "value": "0pt"
            },
            {
              "path": "paragraph_format.space_after",
              "value": "0pt"
            }
          ],
          "check": {
            "type": "docx_expected"
          }
        },
        {
          "id": "table_alignment",
          "label": "表格居中",
          "points": 2,
          "expected": [
            {
              "path": "table.alignment",
              "value": "WD_TABLE_ALIGNMENT.CENTER"
            }
          ],
          "check": {
            "type": "docx_expected"
          }
        },
        {
          "id": "page_margins",
          "label": "页边距",
          "points": 2,
          "expected": [
            {
              "path": "section.top_margin",
              "value": "2.5cm"
            },
            {
              "path": "section.bottom_margin",
              "value": "2.5cm"
            },
            {
              "path": "section.left_margin",
              "value": "3cm"
            },
            {
              "path": "section.right_margin",
              "value": "2.5cm"
            }
          ],
          "check": {
            "type": "manual_review"
          }
        }
      ]
    },
    {
      "id": "content_length",
      "name": "篇幅与结构",
      "weight": 1,
      "rules": [
        {
          "id": "word_count",
          "label": "篇幅",
          "points": 2,
          "expected": [
            {
              "path": "document.word_count",
              "value": "3500~4000"
            }
          ],
          "check": {
            "type": "word_count_range",
            "min": 3500,
            "max": 4000
          }
        },
        {
          "id": "section_count",
          "label": "章节完整性",
          "points": 2,
          "expected": [
            {
              "path": "document.section_count",
              "value": ">=4"
            }
          ],
          "check": {
            "type": "section_count_min",
            "min": 4
          }
        }
      ]
    }
  ]
}
